<Project Sdk="Microsoft.NET.Sdk">

  <!-- Single source of truth for the version: ..\version.txt (also read by TrainerSetup.csproj) -->
  <PropertyGroup>
    <VersionFile>$(MSBuildThisFileDirectory)..\version.txt</VersionFile>
    <TrainerVersion Condition="Exists('$(VersionFile)')">$([System.IO.File]::ReadAllText('$(VersionFile)').Trim())</TrainerVersion>
    <TrainerVersion Condition="'$(TrainerVersion)' == ''">0.0.0</TrainerVersion>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>CrossfireTrainer</AssemblyName>
    <RootNamespace>CrossfireTrainer</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Version>$(TrainerVersion)</Version>
    <FileVersion>$(TrainerVersion).0</FileVersion>
    <InformationalVersion>$(TrainerVersion)</InformationalVersion>
    <NoWarn>CS0618</NoWarn>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <!-- The build needs the game's own assemblies for references. Override with
         -p:GameDir="D:\...\Crossfire Legion (Demo)"  or the CFL_GAME_DIR env var. -->
    <GameDir Condition="'$(GameDir)' == '' and '$(CFL_GAME_DIR)' != ''">$(CFL_GAME_DIR)</GameDir>
    <GameDir Condition="'$(GameDir)' == ''">E:\SteamLibrary\steamapps\common\Crossfire Legion (Demo)</GameDir>
    <ManagedDir>$(GameDir)\Crossfire_Legion_Data\Managed</ManagedDir>
    <BepInExCore>$(GameDir)\BepInEx\core</BepInExCore>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCore)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCore)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ManagedDir)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Carbon.Core">
      <HintPath>$(ManagedDir)\Carbon.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Carbon.Simulation">
      <HintPath>$(ManagedDir)\Carbon.Simulation.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Carbon.Scripting.Lua">
      <HintPath>$(ManagedDir)\Carbon.Scripting.Lua.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- A compile-time constant can be read from a csproj property, so the game panel and the
       BepInPlugin attribute both take the number straight out of version.txt. -->
  <Target Name="GenerateBuildInfo" BeforeTargets="BeforeBuild">
    <MakeDir Directories="$(BaseIntermediateOutputPath)" />
    <WriteLinesToFile File="$(BaseIntermediateOutputPath)BuildInfo.g.cs" Overwrite="true"
                      Lines="namespace CrossfireTrainer { internal static class BuildInfo { internal const string Version = &quot;$(TrainerVersion)&quot;%3B } }" />
    <ItemGroup>
      <Compile Include="$(BaseIntermediateOutputPath)BuildInfo.g.cs" />
    </ItemGroup>
    <Message Importance="high" Text="[build] version $(TrainerVersion)" />
  </Target>

</Project>
